# Never commit real values.
APP_URL=https://your-production-domain.example

# --- Relay (required) -------------------------------------------------------
# The relay refuses to start without RELAY_TOKEN. Generate one with:
#   npm run new-token
# Paste the same value into the Field App: Zoho tab > Sync Key.
RELAY_TOKEN=generate_a_32_byte_random_hex_value
# Comma-separated browser origins allowed to call the relay. No wildcards.
ALLOWED_ORIGINS=http://localhost:5178,https://www.mendtechservices.com
SLACK_WEBHOOK_URL=optional_slack_incoming_webhook
ZOHO_FLOW_WEBHOOK_URL=optional_zoho_flow_webhook

ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_CLIENT_ID=your_client_id
ZOHO_CLIENT_SECRET=store_in_secret_vault
ZOHO_REDIRECT_URI=https://your-production-domain.example/api/zoho/callback
DATABASE_URL=encrypted_database_connection
OTP_PROVIDER=configure_phone_otp_provider
WHATSAPP_BUSINESS_NUMBER=+971522338499
PRIMARY_EMAIL=info@mendtechservices.com
OPTIONAL_CC_EMAIL=mendtech23@gmail.com
